# --- Database -------------------------------------------------------------
# Local Postgres or a Supabase connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inversiones_jcj?schema=public"

# --- Auth -----------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-in-production"
SESSION_MAX_AGE_DAYS="30"

# --- App ------------------------------------------------------------------
APP_URL="http://localhost:3000"
DEFAULT_LOCALE="es"
DEFAULT_CURRENCY="DOP"
DEFAULT_TIMEZONE="America/Santo_Domingo"

# --- WhatsApp (see src/modules/messaging/providers) ------------------------
# Provider: "cloud_api" | "bridge" | "log"
WHATSAPP_PROVIDER="log"
WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=""
WHATSAPP_BRIDGE_URL=""
WHATSAPP_BRIDGE_TOKEN=""

# --- Scheduler ------------------------------------------------------------
# Shared secret required by POST /api/jobs/run
JOBS_SECRET="change-me-in-production"
