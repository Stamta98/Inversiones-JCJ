# --- Base de datos ---------------------------------------------------------
# DATABASE_URL: la usa la aplicación. DIRECT_URL: la usan las migraciones.
# En un Postgres normal las dos apuntan al mismo servidor.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inversiones_jcj?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/inversiones_jcj?schema=public"

# Con Supabase, cópialas de: Project Settings -> Database -> Connection string
# (la contraseña es la del proyecto, no aparece en ningún lado del código).
#
#   DATABASE_URL = la de "Transaction pooler" (puerto 6543)
#                  agregándole  ?pgbouncer=true&connection_limit=1
#   DIRECT_URL   = la de "Direct connection" (puerto 5432)
#
# Ejemplo del proyecto actual (falta reemplazar CONTRASENA):
#   DATABASE_URL="postgresql://postgres.ivhmbqqiccegjoyayvhv:CONTRASENA@aws-0-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
#   DIRECT_URL="postgresql://postgres:CONTRASENA@db.ivhmbqqiccegjoyayvhv.supabase.co:5432/postgres"

# --- Auth -----------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-in-production"
SESSION_MAX_AGE_DAYS="30"

# --- App ------------------------------------------------------------------
APP_URL="http://localhost:3000"
DEFAULT_LOCALE="es"
DEFAULT_CURRENCY="DOP"
DEFAULT_TIMEZONE="America/Santo_Domingo"

# --- WhatsApp (see src/modules/messaging/providers) ------------------------
# Provider: "cloud_api" | "bridge" | "log"
WHATSAPP_PROVIDER="log"
WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=""
WHATSAPP_BRIDGE_URL=""
WHATSAPP_BRIDGE_TOKEN=""

# --- Archivos (fotos de clientes y documentos de identidad) ----------------
# Provider: "local" (disco, para un VPS o Docker) | "supabase" (serverless)
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="./storage"
# Con Supabase: la clave está en Project Settings -> API -> service_role.
# Es secreta, no la subas al repositorio.
SUPABASE_URL="https://ivhmbqqiccegjoyayvhv.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="customer-files"

# --- Scheduler ------------------------------------------------------------
# Shared secret required by POST /api/jobs/run
JOBS_SECRET="change-me-in-production"
