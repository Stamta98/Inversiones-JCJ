# --- Base de datos ---------------------------------------------------------
# DATABASE_URL: la usa la aplicación. DIRECT_URL: la usan las migraciones.
# En un Postgres normal las dos apuntan al mismo servidor.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inversiones_jcj?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/inversiones_jcj?schema=public"

# Con Supabase: botón "Connect" -> ORM -> Prisma. Las dos van por el pooler
# compartido; la conexión directa a db.<ref>.supabase.co es solo IPv6 y no
# sirve desde la mayoría de los hosts.
#
#   DATABASE_URL -> pooler en modo transacción (puerto 6543), para la app
#   DIRECT_URL   -> pooler en modo sesión      (puerto 5432), para migraciones
#
# Las del proyecto actual, solo falta reemplazar CONTRASENA:
#   DATABASE_URL="postgresql://postgres.ivhmbqqiccegjoyayvhv:CONTRASENA@aws-0-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
#   DIRECT_URL="postgresql://postgres.ivhmbqqiccegjoyayvhv:CONTRASENA@aws-0-us-east-2.pooler.supabase.com:5432/postgres"
#
# La contraseña no se puede consultar: se ve una sola vez al crear el proyecto.
# Si no la tienes: Project Settings -> Database -> Reset database password.

# --- Auth -----------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-in-production"
SESSION_MAX_AGE_DAYS="30"

# --- App ------------------------------------------------------------------
APP_URL="http://localhost:3000"
DEFAULT_LOCALE="es"
DEFAULT_CURRENCY="DOP"
DEFAULT_TIMEZONE="America/Santo_Domingo"

# --- WhatsApp (see src/modules/messaging/providers) ------------------------
# Provider: "cloud_api" | "bridge" | "log"
WHATSAPP_PROVIDER="log"
WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=""
WHATSAPP_BRIDGE_URL=""
WHATSAPP_BRIDGE_TOKEN=""

# --- Archivos (fotos de clientes y documentos de identidad) ----------------
# Provider: "local" (disco, para un VPS o Docker) | "supabase" (serverless)
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="./storage"
# Con Supabase: la clave está en Project Settings -> API -> service_role.
# Es secreta, no la subas al repositorio.
SUPABASE_URL="https://ivhmbqqiccegjoyayvhv.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="customer-files"

# --- Scheduler ------------------------------------------------------------
# Shared secret required by POST /api/jobs/run
JOBS_SECRET="change-me-in-production"
